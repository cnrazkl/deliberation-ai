{
  "name": "deliberation-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/with-root-env.mjs pnpm --parallel --filter @deliberation-ai/web --filter @deliberation-ai/worker run dev",
    "dev:e2e": "node scripts/with-root-env.mjs node scripts/e2e-server.mjs",
    "dev:worker": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck && pnpm exec tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:lint-dependencies": "node --test scripts/lint-dependencies.test.mjs",
    "test:integration": "node scripts/with-root-env.mjs pnpm exec vitest run --config vitest.integration.config.ts",
    "test:integration:isolated": "node packages/persistence/scripts/run-isolated-integration.mjs",
    "test:e2e": "node scripts/with-root-env.mjs pnpm exec playwright test",
    "test:watch": "vitest",
    "knowledge:status": "tsx scripts/knowledge-evaluation-workflow.ts status",
    "knowledge:review-status": "tsx scripts/knowledge-evaluation-workflow.ts review-status",
    "knowledge:benchmark": "node packages/persistence/scripts/run-isolated-integration.mjs knowledge-benchmark",
    "knowledge:extraction:verify": "tsx scripts/knowledge-extraction-fixtures.mts",
    "knowledge:prepare": "tsx scripts/knowledge-evaluation-workflow.ts prepare",
    "knowledge:compile-reviews": "tsx scripts/knowledge-evaluation-workflow.ts compile-reviews",
    "knowledge:compile-format-reviews": "tsx scripts/knowledge-evaluation-workflow.ts format-compile",
    "knowledge:format-adjudication:prepare": "tsx scripts/knowledge-evaluation-workflow.ts format-adjudication-prepare",
    "knowledge:format-adjudication:compile": "tsx scripts/knowledge-evaluation-workflow.ts format-adjudication-compile",
    "knowledge:attestation:prepare": "tsx scripts/knowledge-evaluation-workflow.ts attestation-prepare",
    "knowledge:attestation:compile": "tsx scripts/knowledge-evaluation-workflow.ts attestation-compile",
    "knowledge:adjudication:prepare": "tsx scripts/knowledge-evaluation-workflow.ts adjudication-prepare",
    "knowledge:adjudication:compile": "tsx scripts/knowledge-evaluation-workflow.ts adjudication-compile",
    "labeling:prepare": "tsx scripts/council-review-workflow.ts prepare",
    "labeling:compile": "tsx scripts/council-review-workflow.ts compile",
    "labeling:adjudication:prepare": "tsx scripts/council-review-workflow.ts adjudication-prepare",
    "labeling:adjudication:compile": "tsx scripts/council-review-workflow.ts adjudication-compile",
    "correctness:prepare": "tsx scripts/council-correctness-workflow.ts prepare",
    "correctness:status": "tsx scripts/council-correctness-workflow.ts status",
    "prompt:prepare": "tsx scripts/prompt-comparison-workflow.ts prepare",
    "prompt:status": "tsx scripts/prompt-comparison-workflow.ts status",
    "prompt:adjudication:prepare": "tsx scripts/prompt-comparison-workflow.ts adjudication-prepare",
    "prompt:adjudication:compile": "tsx scripts/prompt-comparison-workflow.ts adjudication-compile",
    "measurement:prepare": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence measurement:prepare",
    "measurement:review": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence measurement:review",
    "measurement:score": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence measurement:score",
    "review-rounds:prepare": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence review-rounds:prepare",
    "review-rounds:status": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence review-rounds:status",
    "early-stop:inspect": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence early-stop:inspect",
    "pricing:record": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence pricing:record",
    "pricing:list": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence pricing:list",
    "billing:preview": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:preview",
    "billing:record": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:record",
    "billing:list": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:list",
    "billing:show": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:show",
    "billing:statement:inspect": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:statement:inspect",
    "billing:account:inspect": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:account:inspect",
    "billing:payment:inspect": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:payment:inspect",
    "billing:statement:preview": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:statement:preview",
    "billing:statement:record": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:statement:record",
    "billing:statement:list": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:statement:list",
    "billing:statement:show": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:statement:show",
    "billing:change:preview": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:change:preview",
    "billing:change:record": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:change:record",
    "billing:reallocate:preview": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:reallocate:preview",
    "billing:reallocate:record": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence billing:reallocate:record",
    "contradiction:labels": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence contradiction:labels",
    "db:setup-portable": "pnpm --filter @deliberation-ai/persistence db:setup-portable",
    "db:start": "pnpm --filter @deliberation-ai/persistence db:start",
    "db:status": "pnpm --filter @deliberation-ai/persistence db:status",
    "db:stop": "pnpm --filter @deliberation-ai/persistence db:stop",
    "db:generate": "pnpm --filter @deliberation-ai/persistence db:generate",
    "db:migrate": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:migrate",
    "db:encrypt-existing": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:encrypt-existing",
    "db:branches:index": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:branches:index",
    "db:conversations:index": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:conversations:index",
    "db:prune": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:prune",
    "db:prune:apply": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:prune:apply",
    "db:backup": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:backup",
    "db:backup:verify": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:backup:verify",
    "db:backup:rehearse": "node scripts/with-root-env.mjs pnpm --filter @deliberation-ai/persistence db:backup:rehearse"
  },
  "devDependencies": {
    "@deliberation-ai/evaluation": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
