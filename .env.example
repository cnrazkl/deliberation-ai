APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://deliberation:change-me@127.0.0.1:5432/deliberation_ai
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
KEY_VERSION=1
LOG_LEVEL=info
WORKER_CONCURRENCY=1
ENABLE_DECISION_EVALUATOR=false
DECISION_WORKER_CONCURRENCY=1
FAKE_PROVIDER_MODE=true
RUN_RETENTION_DAYS=30
